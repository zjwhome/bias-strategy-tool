# ============================================================
# 乖离率超跌反弹策略工具 · Git 忽略规则
# ============================================================

# ---------- 行情数据（体积巨大：合计约 2.2GB，且属于本机数据） ----------
# 这些目录是本地缓存/回测产物，克隆仓库后由程序自动重新生成
data_long/
data_full/
output_long/
output_full/

# ---------- 本地数据库与运行日志 ----------
webapp/data.db
webapp/data.db-wal
webapp/data.db-shm
webapp/server_console.log
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------- 开发期临时探针脚本（下划线开头） ----------
_*.py

# ---------- WorkBuddy 工作区内部数据（含个人工作笔记） ----------
.workbuddy/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
